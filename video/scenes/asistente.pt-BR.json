{
  "lesson": "asistente",
  "baseUrl": "https://sevenai.es",
  "locale": "pt-BR",
  "setup": [
    {
      "do": "goto",
      "url": "/educa/ai-agents"
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Novo Modelo\")"
    },
    {
      "do": "click",
      "selector": "button:has-text(\"Novo Modelo\")"
    },
    {
      "do": "waitFor",
      "selector": "textarea[placeholder^=\"Você é\"]"
    },
    {
      "do": "wait",
      "ms": 800
    }
  ],
  "scenes": [
    {
      "id": "inicio",
      "say": "Um assistente de IA é um modelo que você configura uma vez e usa em todas as suas aulas. Vamos criar um para o laboratório.",
      "actions": [
        {
          "do": "caption",
          "text": "Crie um assistente para a sua aula",
          "step": ""
        },
        {
          "do": "wait",
          "ms": 1800
        },
        {
          "do": "shot",
          "name": "asistente-1-lista"
        }
      ]
    },
    {
      "id": "abrir",
      "say": "Clique em Novo Modelo.",
      "actions": [
        {
          "do": "caption",
          "text": "1 · Novo modelo",
          "step": ""
        },
        {
          "do": "waitFor",
          "selector": "textarea[placeholder^=\"Você é\"]"
        },
        {
          "do": "wait",
          "ms": 800
        },
        {
          "do": "shot",
          "name": "asistente-2-formulario"
        }
      ]
    },
    {
      "id": "nombre",
      "say": "Dê um nome que se entenda logo: Assistente de práticas de laboratório.",
      "actions": [
        {
          "do": "caption",
          "text": "2 · Dê um nome",
          "step": ""
        },
        {
          "do": "type",
          "selector": "input:not([type=\"file\"]):not([type=\"hidden\"]) >> nth=0",
          "text": "Assistente de práticas de laboratório",
          "delay": 40
        },
        {
          "do": "wait",
          "ms": 600
        }
      ]
    },
    {
      "id": "herramientas",
      "say": "Escolha o que ele pode fazer: pesquisa na web, criar imagens ou criar H5P.",
      "actions": [
        {
          "do": "caption",
          "text": "3 · Escolha as ferramentas",
          "step": ""
        },
        {
          "do": "click",
          "selector": "button:has-text(\"Pesquisa Web\")"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "click",
          "selector": "button:has-text(\"Criar H5P\")"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "shot",
          "name": "asistente-3-herramientas"
        }
      ]
    },
    {
      "id": "instruccion",
      "say": "Na instrução, explique como ele deve responder. Por exemplo: dê pistas, mas não soluções completas.",
      "actions": [
        {
          "do": "caption",
          "text": "4 · Defina como ele responde",
          "step": ""
        },
        {
          "do": "type",
          "selector": "textarea[placeholder^=\"Você é\"]",
          "text": "Dê pistas e faça perguntas aos alunos, mas não dê soluções completas.",
          "delay": 22
        },
        {
          "do": "wait",
          "ms": 700
        },
        {
          "do": "shot",
          "name": "asistente-4-instruccion"
        }
      ]
    },
    {
      "id": "guardar",
      "say": "Clique em Salvar. O assistente fica disponível para iniciar conversas.",
      "actions": [
        {
          "do": "caption",
          "text": "5 · Salve",
          "step": ""
        },
        {
          "do": "click",
          "selector": "button:has-text(\"Salvar\")"
        },
        {
          "do": "wait",
          "ms": 2200
        },
        {
          "do": "shot",
          "name": "asistente-5-guardado"
        }
      ]
    },
    {
      "id": "probar",
      "say": "Antes de usar com a sua turma, teste. Se a resposta for completa demais, volte à instrução e torne-a mais precisa.",
      "actions": [
        {
          "do": "caption",
          "text": "Teste com uma pergunta",
          "step": ""
        },
        {
          "do": "click",
          "selector": ".agents-item__content:has-text(\"Assistente de práticas de laboratório\") button[aria-label=\"Iniciar um chat com este modelo\"]"
        },
        {
          "do": "waitFor",
          "selector": "div[contenteditable=\"true\"]"
        },
        {
          "do": "click",
          "selector": "div[contenteditable=\"true\"]"
        },
        {
          "do": "type",
          "selector": "div[contenteditable=\"true\"]",
          "text": "Como calculo o tamanho de uma célula de cebola com o microscópio?",
          "delay": 30
        },
        {
          "do": "wait",
          "ms": 700
        },
        {
          "do": "click",
          "selector": "[aria-label=\"Enviar mensagem\"]"
        },
        {
          "do": "wait",
          "ms": 26000
        },
        {
          "do": "shot",
          "name": "asistente-6-prueba"
        }
      ]
    },
    {
      "id": "final",
      "say": "Pronto: basta iniciar um chat com ele quando precisar.",
      "actions": [
        {
          "do": "caption",
          "text": "Assistente pronto",
          "step": ""
        },
        {
          "do": "wait",
          "ms": 2000
        }
      ]
    }
  ]
}
