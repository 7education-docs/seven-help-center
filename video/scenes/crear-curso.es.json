{
  "lesson": "crear-curso",
  "baseUrl": "https://sevenai.es",
  "locale": "es",
  "setup": [
    {
      "do": "goto",
      "url": "/educa/courses"
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Crear curso\")"
    }
  ],
  "scenes": [
    {
      "id": "inicio",
      "say": "Un curso reúne en un solo lugar lo que trabajas con un grupo.",
      "actions": [
        {
          "do": "caption",
          "text": "Crear un curso",
          "step": ""
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "criar-hl",
      "say": "Para crear uno, pulsa Crear curso.",
      "actions": [
        {
          "do": "highlight",
          "selector": "role=button[name=\"Crear curso\"]",
          "ms": 2600
        },
        {
          "do": "wait",
          "ms": 400
        }
      ]
    },
    {
      "id": "importar-hl",
      "say": "También puedes importar un curso que ya tienes, con el botón Importar curso.",
      "actions": [
        {
          "do": "highlight",
          "selector": "button:has-text(\"Importar curso\")",
          "ms": 2800
        },
        {
          "do": "wait",
          "ms": 400
        }
      ]
    },
    {
      "id": "modelos",
      "say": "O adoptar una plantilla. Las plantillas son unidades didácticas con secciones y materiales, que adaptas a tu grupo.",
      "actions": [
        {
          "do": "click",
          "selector": "button[role=\"tab\"]:has-text(\"Plantillas\")"
        },
        {
          "do": "wait",
          "ms": 3200
        }
      ]
    },
    {
      "id": "passo-1",
      "say": "Pon un nombre al curso.",
      "actions": [
        {
          "do": "click",
          "selector": "role=button[name=\"Crear curso\"]"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "caption",
          "text": "1 · Datos básicos",
          "step": ""
        },
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=0",
          "text": "Matemáticas · 2.º ESO",
          "delay": 35
        },
        {
          "do": "wait",
          "ms": 300
        }
      ]
    },
    {
      "id": "passo-1b",
      "say": "Indica la asignatura y la clase.",
      "actions": [
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=1",
          "text": "Matemáticas",
          "delay": 35
        },
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=2",
          "text": "2.º ESO",
          "delay": 35
        },
        {
          "do": "wait",
          "ms": 300
        }
      ]
    },
    {
      "id": "passo-1c",
      "say": "Escribe una descripción, por ejemplo: Matemáticas, 2.º ESO.",
      "actions": [
        {
          "do": "type",
          "selector": "textarea >> nth=0",
          "text": "Curso de matemáticas para 2.º de ESO",
          "delay": 30
        },
        {
          "do": "wait",
          "ms": 800
        }
      ]
    },
    {
      "id": "vazio",
      "say": "En el segundo paso, elige el contenido inicial. Vacío empieza con una sección General para construirlo tú.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Siguiente\")"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "caption",
          "text": "2 · Elegir contenido",
          "step": ""
        },
        {
          "do": "click",
          "selector": "button:has-text(\"Vacío\")"
        },
        {
          "do": "wait",
          "ms": 1500
        }
      ]
    },
    {
      "id": "todos",
      "say": "Todas las plantillas trae unidades ya preparadas, para adaptar en vez de empezar desde cero.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Todas las plantillas\")"
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "copiar",
      "say": "Copiar reutiliza un curso que ya tienes.",
      "actions": [
        {
          "do": "highlight",
          "selector": "button:has-text(\"Copiar\")",
          "ms": 2600
        },
        {
          "do": "wait",
          "ms": 400
        }
      ]
    },
    {
      "id": "ia-hl",
      "say": "Planificar con IA es la opción de más valor.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Planificar con IA\")"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "caption",
          "text": "Planificar con IA",
          "step": ""
        }
      ]
    },
    {
      "id": "ia-texto",
      "say": "Describe el tema, los objetivos y la duración, y la IA monta las secciones.",
      "actions": [
        {
          "do": "type",
          "selector": "textarea >> nth=0",
          "text": "Fracciones para 6.º curso, ocho semanas, con ejercicios y un examen.",
          "delay": 25
        },
        {
          "do": "wait",
          "ms": 800
        }
      ]
    },
    {
      "id": "ia-criar",
      "say": "Pulsa Crear plan.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Crear plan\")"
        },
        {
          "do": "wait",
          "ms": 600
        }
      ]
    },
    {
      "id": "plano",
      "say": "La IA monta las secciones en unos segundos, cada una con sus contenidos. Revisa el plan antes de crear el curso.",
      "actions": [
        {
          "do": "waitFor",
          "selector": "text=Creando el plan"
        },
        {
          "do": "waitGone",
          "selector": "text=Creando el plan",
          "timeout": 150000
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "passo-3",
      "say": "Revisa los datos y pulsa Crear.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Siguiente\")"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "caption",
          "text": "3 · Revisar y crear",
          "step": ""
        },
        {
          "do": "wait",
          "ms": 1500
        },
        {
          "do": "click",
          "selector": "button:text-is(\"Crear\")"
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "resultado",
      "say": "Al abrir el curso, verás los borradores de IA en la vista general. Revísalos y publícalos cuando estén listos.",
      "actions": [
        {
          "do": "wait",
          "ms": 5000
        }
      ]
    }
  ]
}