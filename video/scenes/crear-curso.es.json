{
  "lesson": "crear-curso",
  "baseUrl": "https://sevenai.es",
  "locale": "es",
  "setup": [
    {
      "do": "goto",
      "url": "/educa/courses"
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Crear curso\")"
    }
  ],
  "scenes": [
    {
      "id": "inicio",
      "say": "Un curso reúne en un solo lugar lo que trabajas con un grupo. Para crear uno, pulsa Crear curso.",
      "actions": [
        {
          "do": "caption",
          "text": "Crear un curso",
          "step": ""
        },
        {
          "do": "highlight",
          "selector": "button:has-text(\"Crear curso\")",
          "ms": 2000
        },
        {
          "do": "wait",
          "ms": 5000
        }
      ]
    },
    {
      "id": "passo-1",
      "say": "Pon un nombre, indica la asignatura y el curso. Es lo que ven en la lista de cursos y lo que el alumnado busca al entrar.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Crear curso\")"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "caption",
          "text": "1 · Datos básicos",
          "step": ""
        },
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=0",
          "text": "Matemáticas · 2.º ESO",
          "delay": 40
        },
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=1",
          "text": "Matemáticas",
          "delay": 40
        },
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=2",
          "text": "2.º ESO",
          "delay": 40
        },
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    },
    {
      "id": "opcoes",
      "say": "En el segundo paso eliges el contenido inicial. Vacío empieza con una sección General para montarlo tú. Todas las plantillas trae unidades ya preparadas. Copiar reutiliza parte de un curso que ya tienes.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Siguiente\")"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "caption",
          "text": "2 · Elegir contenido",
          "step": ""
        },
        {
          "do": "highlight",
          "selector": "button:has-text(\"Vacío\")",
          "ms": 2200
        },
        {
          "do": "wait",
          "ms": 2600
        },
        {
          "do": "highlight",
          "selector": "button:has-text(\"Todas las plantillas\")",
          "ms": 2200
        },
        {
          "do": "wait",
          "ms": 2600
        },
        {
          "do": "highlight",
          "selector": "button:has-text(\"Copiar\")",
          "ms": 2200
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "planear-ia",
      "say": "Planificar con IA es la opción más útil cuando necesitas una primera versión. Describe el tema, los objetivos y la duración, y la IA monta las secciones.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Planificar con IA\")"
        },
        {
          "do": "wait",
          "ms": 1500
        },
        {
          "do": "caption",
          "text": "Planificar con IA",
          "step": ""
        },
        {
          "do": "type",
          "selector": "textarea >> nth=0",
          "text": "Fracciones para 6.º curso, ocho semanas, con ejercicios y un examen.",
          "delay": 25
        },
        {
          "do": "wait",
          "ms": 2500
        }
      ]
    },
    {
      "id": "plano",
      "say": "Pulsa Crear plan y la IA monta las secciones. Todo empieza como borrador: el alumnado solo lo ve cuando lo publicas.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Crear plan\")"
        },
        {
          "do": "waitFor",
          "selector": "text=Creando el plan"
        },
        {
          "do": "waitGone",
          "selector": "text=Creando el plan",
          "timeout": 150000
        },
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    },
    {
      "id": "passo-3",
      "say": "Revisa los datos y crea el curso. Aparece con las secciones del plan, listas para revisar.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Siguiente\")"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "caption",
          "text": "3 · Revisar y crear",
          "step": ""
        },
        {
          "do": "wait",
          "ms": 2000
        },
        {
          "do": "click",
          "selector": "button:text-is(\"Crear\")"
        },
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    },
    {
      "id": "resultado",
      "say": "Al abrir el curso, verás los borradores de IA en la vista general. Revísalos y publícalos cuando estén listos.",
      "actions": [
        {
          "do": "wait",
          "ms": 6000
        }
      ]
    }
  ]
}