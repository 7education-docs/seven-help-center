{
  "lesson": "crear-curso",
  "baseUrl": "https://sevenai.es",
  "locale": "pt-BR",
  "setup": [
    {
      "do": "goto",
      "url": "/educa/courses"
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Criar curso\")"
    }
  ],
  "scenes": [
    {
      "id": "inicio",
      "say": "Um curso reúne em um só lugar o que você trabalha com uma turma. Para criar um, clique em Criar curso.",
      "actions": [
        {
          "do": "caption",
          "text": "Criar um curso",
          "step": ""
        },
        {
          "do": "highlight",
          "selector": "button:has-text(\"Criar curso\")",
          "ms": 2000
        },
        {
          "do": "wait",
          "ms": 5000
        }
      ]
    },
    {
      "id": "passo-1",
      "say": "Dê um nome, indique a disciplina e a turma. É o que você vê na lista de cursos e o que o estudante procura ao entrar.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Criar curso\")"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "caption",
          "text": "1 · Dados básicos",
          "step": ""
        },
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=0",
          "text": "Ciências · 7.º ano",
          "delay": 40
        },
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=1",
          "text": "Ciências",
          "delay": 40
        },
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=2",
          "text": "7.º ano",
          "delay": 40
        },
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    },
    {
      "id": "opcoes",
      "say": "No segundo passo, escolha o conteúdo inicial. Vazio começa com uma seção Geral para você montar tudo. Todos os modelos traz unidades prontas. Copiar parte de um curso que você já tem.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Seguinte\")"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "caption",
          "text": "2 · Escolher conteúdo",
          "step": ""
        },
        {
          "do": "highlight",
          "selector": "button:has-text(\"Vazio\")",
          "ms": 2200
        },
        {
          "do": "wait",
          "ms": 2600
        },
        {
          "do": "highlight",
          "selector": "button:has-text(\"Todos os modelos\")",
          "ms": 2200
        },
        {
          "do": "wait",
          "ms": 2600
        },
        {
          "do": "highlight",
          "selector": "button:has-text(\"Copiar\")",
          "ms": 2200
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "planear-ia",
      "say": "Planear com IA é a opção mais útil quando precisa de uma primeira versão. Descreva o tema, os objetivos e a duração, e a IA monta as seções.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Planear com IA\")"
        },
        {
          "do": "wait",
          "ms": 1500
        },
        {
          "do": "caption",
          "text": "Planear com IA",
          "step": ""
        },
        {
          "do": "type",
          "selector": "textarea >> nth=0",
          "text": "Frações para o 6.º ano, oito semanas, com exercícios e um teste.",
          "delay": 25
        },
        {
          "do": "wait",
          "ms": 2500
        }
      ]
    },
    {
      "id": "plano",
      "say": "Clique em Criar plano e a IA monta as seções. Tudo começa como rascunho: os alunos só veem o conteúdo depois que você publicar.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Criar plano\")"
        },
        {
          "do": "waitFor",
          "selector": "text=A criar o plano"
        },
        {
          "do": "waitGone",
          "selector": "text=A criar o plano",
          "timeout": 150000
        },
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    },
    {
      "id": "passo-3",
      "say": "Revise os dados e crie o curso. Ele aparece com as seções do plano, prontas para você revisar.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Seguinte\")"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "caption",
          "text": "3 · Verificar e criar",
          "step": ""
        },
        {
          "do": "wait",
          "ms": 2000
        },
        {
          "do": "click",
          "selector": "button:text-is(\"Criar\")"
        },
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    },
    {
      "id": "resultado",
      "say": "Ao abrir o curso, verá os rascunhos de IA na visão geral. Revise-os e publique quando estiverem prontos.",
      "actions": [
        {
          "do": "wait",
          "ms": 6000
        }
      ]
    }
  ]
}