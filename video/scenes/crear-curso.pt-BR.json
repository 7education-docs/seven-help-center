{
  "lesson": "crear-curso",
  "baseUrl": "https://sevenai.es",
  "locale": "pt-BR",
  "setup": [
    {
      "do": "goto",
      "url": "/educa/courses"
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Criar curso\")"
    }
  ],
  "scenes": [
    {
      "id": "inicio",
      "say": "Um curso reúne, em um só lugar, o que você trabalha com um grupo.",
      "actions": [
        {
          "do": "caption",
          "text": "Criar um curso",
          "step": ""
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "criar-hl",
      "say": "Para criar um, clique em Criar curso.",
      "actions": [
        {
          "do": "highlight",
          "selector": "button:has-text(\"Criar curso\")",
          "ms": 2600
        },
        {
          "do": "wait",
          "ms": 400
        }
      ]
    },
    {
      "id": "importar-hl",
      "say": "Você também pode importar um curso que já tem, com o botão Importar curso.",
      "actions": [
        {
          "do": "highlight",
          "selector": "button:has-text(\"Importar curso\")",
          "ms": 2800
        },
        {
          "do": "wait",
          "ms": 400
        }
      ]
    },
    {
      "id": "modelos",
      "say": "Ou adotar um modelo pronto. Os modelos são unidades didáticas com seções e materiais, que você adapta ao seu grupo.",
      "actions": [
        {
          "do": "click",
          "selector": "button[role=\"tab\"]:has-text(\"Modelos\")"
        },
        {
          "do": "wait",
          "ms": 3200
        }
      ]
    },
    {
      "id": "passo-1",
      "say": "Dê um nome ao curso.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Criar curso\")"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "caption",
          "text": "1 · Dados básicos",
          "step": ""
        },
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=0",
          "text": "Matemática · 8.º ano",
          "delay": 35
        },
        {
          "do": "wait",
          "ms": 300
        }
      ]
    },
    {
      "id": "passo-1b",
      "say": "Indique a disciplina e a turma.",
      "actions": [
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=1",
          "text": "Matemática",
          "delay": 35
        },
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=2",
          "text": "8.º ano",
          "delay": 35
        },
        {
          "do": "wait",
          "ms": 300
        }
      ]
    },
    {
      "id": "passo-1c",
      "say": "Escreva uma descrição, por exemplo: Matemática, 8.º ano.",
      "actions": [
        {
          "do": "type",
          "selector": "textarea >> nth=0",
          "text": "Curso de matemática para o 8.º ano",
          "delay": 30
        },
        {
          "do": "wait",
          "ms": 800
        }
      ]
    },
    {
      "id": "vazio",
      "say": "No segundo passo, escolha o conteúdo inicial. Vazio começa com uma seção Geral para você montar tudo.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Seguinte\")"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "caption",
          "text": "2 · Escolher conteúdo",
          "step": ""
        },
        {
          "do": "click",
          "selector": "button:has-text(\"Vazio\")"
        },
        {
          "do": "wait",
          "ms": 1500
        }
      ]
    },
    {
      "id": "todos",
      "say": "Todos os modelos traz unidades prontas, para adaptar em vez de começar do zero.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Todos os modelos\")"
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "copiar",
      "say": "Copiar reaproveita um curso que você já tem.",
      "actions": [
        {
          "do": "highlight",
          "selector": "button:has-text(\"Copiar\")",
          "ms": 2600
        },
        {
          "do": "wait",
          "ms": 400
        }
      ]
    },
    {
      "id": "ia-hl",
      "say": "Planear com IA é a opção de mais valor.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Planear com IA\")"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "caption",
          "text": "Planear com IA",
          "step": ""
        }
      ]
    },
    {
      "id": "ia-texto",
      "say": "Descreva o tema, os objetivos e a duração, e a IA monta as seções.",
      "actions": [
        {
          "do": "type",
          "selector": "textarea >> nth=0",
          "text": "Frações para o 6.º ano, oito semanas, com exercícios e um teste.",
          "delay": 25
        },
        {
          "do": "wait",
          "ms": 800
        }
      ]
    },
    {
      "id": "ia-criar",
      "say": "Clique em Criar plano.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Criar plano\")"
        },
        {
          "do": "wait",
          "ms": 600
        }
      ]
    },
    {
      "id": "plano",
      "say": "A IA monta as seções em poucos segundos, cada uma com os seus conteúdos. Revise o plano antes de criar o curso.",
      "actions": [
        {
          "do": "waitFor",
          "selector": "text=A criar o plano"
        },
        {
          "do": "waitGone",
          "selector": "text=A criar o plano",
          "timeout": 150000
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "passo-3",
      "say": "Revise os dados e clique em Criar.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Seguinte\")"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "caption",
          "text": "3 · Verificar e criar",
          "step": ""
        },
        {
          "do": "wait",
          "ms": 1500
        },
        {
          "do": "click",
          "selector": "button:text-is(\"Criar\")"
        },
        {
          "do": "waitFor",
          "selector": "text=Convidar alunos"
        },
        {
          "do": "wait",
          "ms": 3000
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "resultado",
      "say": "Ao abrir o curso, verá os rascunhos de IA na visão geral. Revise-os e publique quando estiverem prontos.",
      "actions": [
        {
          "do": "wait",
          "ms": 5000
        }
      ]
    }
  ]
}