{
  "lesson": "material-archivo",
  "baseUrl": "https://sevenai.es",
  "locale": "pt-BR",
  "setup": [
    {
      "do": "goto",
      "url": "/educa/courses"
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Criar curso\")"
    },
    {
      "do": "click",
      "selector": "h3:has-text(\"Matemática · 8.º ano\")"
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Adicionar atividade ou material\")"
    }
  ],
  "scenes": [
    {
      "id": "tipo",
      "say": "Material é um arquivo que o estudante pode abrir dentro da seção: um PDF, uma apresentação ou um vídeo. Use para o que ele deve consultar, sem entregar nada.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Adicionar atividade ou material\")"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "click",
          "selector": "button:has-text(\"Material\"):not(:has-text(\"Texto\")):not(:has-text(\"Adicionar\"))"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    },
    {
      "id": "carregar",
      "say": "Você envia o arquivo do seu computador ou escolhe um que já está na biblioteca.",
      "actions": [
        {
          "do": "highlight",
          "selector": "button:has-text(\"Carregar ficheiro\")",
          "ms": 2600
        },
        {
          "do": "wait",
          "ms": 6500
        }
      ]
    },
    {
      "id": "titulo",
      "say": "Dê ao material um título que diga o conteúdo. Por exemplo, 'Ficha de apoio: partes da célula' é mais claro do que 'Doc1'.",
      "actions": [
        {
          "do": "type",
          "selector": "input[placeholder=\" \"] >> nth=0",
          "text": "Ficha de apoio: partes da célula",
          "delay": 40
        },
        {
          "do": "wait",
          "ms": 4500
        }
      ]
    },
    {
      "id": "fim",
      "say": "Ao pulsar Adicionar, o material aparece na seção. Se ainda não quiser que o estudante o veja, deixe-o oculto.",
      "actions": [
        {
          "do": "click",
          "selector": "button:text-is(\"Voltar\")"
        },
        {
          "do": "wait",
          "ms": 5000
        }
      ]
    }
  ]
}