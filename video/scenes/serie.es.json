{
  "lesson": "serie",
  "baseUrl": "https://sevenai.es",
  "locale": "es",
  "setup": [
    {
      "do": "goto",
      "url": "/educa/library"
    },
    {
      "do": "waitFor",
      "selector": "text=\"Serie de lecciones\""
    },
    {
      "do": "click",
      "selector": "text=\"Serie de lecciones\""
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Generar con IA\")"
    }
  ],
  "scenes": [
    {
      "id": "inicio",
      "say": "Hay dos formas de crear una serie de lecciones.",
      "actions": [
        {
          "do": "caption",
          "text": "Dos formas de crear",
          "step": ""
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "criar-hl",
      "say": "Crear la monta a mano, lección por lección.",
      "actions": [
        {
          "do": "highlight",
          "selector": "role=button[name=\"Crear\"]",
          "ms": 3000
        },
        {
          "do": "wait",
          "ms": 500
        }
      ]
    },
    {
      "id": "gerar-hl",
      "say": "Generar con IA crea la serie completa a partir de un tema.",
      "actions": [
        {
          "do": "highlight",
          "selector": "button:has-text(\"Generar con IA\")",
          "ms": 3000
        },
        {
          "do": "wait",
          "ms": 500
        }
      ]
    },
    {
      "id": "criar-abrir",
      "say": "Con Crear, rellenas el tema, la asignatura y la descripción.",
      "actions": [
        {
          "do": "click",
          "selector": "role=button[name=\"Crear\"]"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "caption",
          "text": "Crear: la serie empieza vacía",
          "step": ""
        },
        {
          "do": "type",
          "selector": "input[placeholder^=\"ej. Introducción\"]",
          "text": "Niveles de organización de los seres vivos",
          "delay": 35
        },
        {
          "do": "wait",
          "ms": 600
        }
      ]
    },
    {
      "id": "criar-desc",
      "say": "La serie nace vacía, y añades cada lección tú.",
      "actions": [
        {
          "do": "highlight",
          "selector": "textarea[placeholder^=\"Describa brevemente\"]",
          "ms": 3000
        },
        {
          "do": "wait",
          "ms": 500
        }
      ]
    },
    {
      "id": "criar-fim",
      "say": "Úsala cuando ya tienes el plan.",
      "actions": [
        {
          "do": "wait",
          "ms": 800
        },
        {
          "do": "press",
          "key": "Escape"
        },
        {
          "do": "wait",
          "ms": 1200
        }
      ]
    },
    {
      "id": "gerar-ia",
      "say": "Para no empezar desde cero, usa Generar con IA: la IA crea las lecciones con su progresión y su evaluación, y tú la revisas después.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Generar con IA\")"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "caption",
          "text": "Generar con IA",
          "step": ""
        },
        {
          "do": "wait",
          "ms": 2200
        }
      ]
    },
    {
      "id": "tema-a",
      "say": "El formulario pide el tema y la asignatura.",
      "actions": [
        {
          "do": "wait",
          "ms": 300
        },
        {
          "do": "type",
          "selector": "input[placeholder^=\"ej. La Revolución\"]",
          "text": "La fotosíntesis: de la luz a la materia",
          "delay": 35
        },
        {
          "do": "wait",
          "ms": 500
        }
      ]
    },
    {
      "id": "tema-b",
      "say": "Cuanto más contexto des, más ajustada queda la serie.",
      "actions": [
        {
          "do": "type",
          "selector": "input[placeholder=\"ej. Historia\"]",
          "text": "Ciencias Naturales",
          "delay": 35
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"p. ej. 3.º de ESO\"]",
          "text": "2.º de ESO",
          "delay": 35
        },
        {
          "do": "wait",
          "ms": 800
        }
      ]
    },
    {
      "id": "estrutura",
      "say": "Elige el número de lecciones. Así la serie sale con el tamaño que cabe en tu trimestre.",
      "actions": [
        {
          "do": "click",
          "selector": "input[placeholder=\"ej. 4\"]"
        },
        {
          "do": "press",
          "key": "Control+a"
        },
        {
          "do": "press",
          "key": "Backspace"
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"ej. 4\"]",
          "text": "6",
          "delay": 60
        },
        {
          "do": "wait",
          "ms": 1500
        }
      ]
    },
    {
      "id": "objetivos",
      "say": "Los objetivos indican lo que el alumnado debe conseguir al final.",
      "actions": [
        {
          "do": "type",
          "selector": "textarea[placeholder^=\"ej. Los alumnos\"]",
          "text": "Explicar cómo transforman las plantas la luz en materia.",
          "delay": 25
        },
        {
          "do": "wait",
          "ms": 800
        }
      ]
    },
    {
      "id": "gerar-a",
      "say": "Pulsa Generar serie.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Generar serie\")"
        },
        {
          "do": "wait",
          "ms": 800
        }
      ]
    },
    {
      "id": "gerar-b",
      "say": "Cuando termine, la serie aparece en tu biblioteca, con las lecciones listas para revisar.",
      "actions": [
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    }
  ]
}