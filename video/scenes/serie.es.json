{
  "lesson": "serie",
  "baseUrl": "https://sevenai.es",
  "locale": "es",
  "setup": [
    {
      "do": "goto",
      "url": "/educa/library"
    },
    {
      "do": "waitFor",
      "selector": "text=\"Serie de lecciones\""
    },
    {
      "do": "click",
      "selector": "text=\"Serie de lecciones\""
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Generar con IA\")"
    }
  ],
  "scenes": [
    {
      "id": "inicio",
      "say": "Una serie de lecciones planifica un tema completo: las sesiones, la progresión y la evaluación. Para no empezar desde cero, usa Generar con IA.",
      "actions": [
        {
          "do": "caption",
          "text": "Generar con IA",
          "step": ""
        },
        {
          "do": "highlight",
          "selector": "button:has-text(\"Generar con IA\")",
          "ms": 2200
        },
        {
          "do": "wait",
          "ms": 6000
        }
      ]
    },
    {
      "id": "tema",
      "say": "El formulario pide el tema, la asignatura y el curso. Cuanto más contexto des, más ajustada queda la serie.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Generar con IA\")"
        },
        {
          "do": "wait",
          "ms": 1500
        },
        {
          "do": "type",
          "selector": "input[placeholder^=\"ej. La Revolución\"]",
          "text": "La fotosíntesis: de la luz a la materia",
          "delay": 35
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"ej. Historia\"]",
          "text": "Ciencias Naturales",
          "delay": 35
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"p. ej. 3.º de ESO\"]",
          "text": "2.º de ESO",
          "delay": 35
        },
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    },
    {
      "id": "estrutura",
      "say": "Elige el número de lecciones. Así la serie sale con el tamaño que cabe en tu trimestre.",
      "actions": [
        {
          "do": "click",
          "selector": "input[placeholder=\"ej. 4\"]"
        },
        {
          "do": "press",
          "key": "Control+a"
        },
        {
          "do": "press",
          "key": "Backspace"
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"ej. 4\"]",
          "text": "6",
          "delay": 60
        },
        {
          "do": "wait",
          "ms": 5000
        }
      ]
    },
    {
      "id": "objetivos",
      "say": "Los objetivos indican lo que el alumnado debe conseguir al final. La IA organiza las sesiones para llegar hasta ellos.",
      "actions": [
        {
          "do": "type",
          "selector": "textarea[placeholder^=\"ej. Los alumnos\"]",
          "text": "Explicar cómo transforman las plantas la luz en materia.",
          "delay": 25
        },
        {
          "do": "wait",
          "ms": 5000
        }
      ]
    },
    {
      "id": "gerar",
      "say": "Pulsa Generar serie y la IA crea la serie. Cuando termine, aparece en tu biblioteca, con las lecciones listas para revisar.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Generar serie\")"
        },
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    }
  ]
}