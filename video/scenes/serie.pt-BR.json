{
  "lesson": "serie",
  "baseUrl": "https://sevenai.es",
  "locale": "pt-BR",
  "setup": [
    {
      "do": "goto",
      "url": "/educa/library"
    },
    {
      "do": "waitFor",
      "selector": "text=\"Série de lições\""
    },
    {
      "do": "click",
      "selector": "text=\"Série de lições\""
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Gerar com IA\")"
    }
  ],
  "scenes": [
    {
      "id": "inicio",
      "say": "Há duas formas de criar uma série de lições.",
      "actions": [
        {
          "do": "caption",
          "text": "Duas formas de criar",
          "step": ""
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "criar-hl",
      "say": "Com Criar, você monta a série à mão, lição por lição.",
      "actions": [
        {
          "do": "highlight",
          "selector": "role=button[name=\"Criar\"]",
          "ms": 3000
        },
        {
          "do": "wait",
          "ms": 500
        }
      ]
    },
    {
      "id": "gerar-hl",
      "say": "Gerar com IA cria a série inteira a partir de um tema.",
      "actions": [
        {
          "do": "highlight",
          "selector": "button:has-text(\"Gerar com IA\")",
          "ms": 3000
        },
        {
          "do": "wait",
          "ms": 500
        }
      ]
    },
    {
      "id": "criar-abrir",
      "say": "Com Criar, você preenche o tema, a disciplina e a descrição.",
      "actions": [
        {
          "do": "click",
          "selector": "role=button[name=\"Criar\"]"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "caption",
          "text": "Criar: a série começa vazia",
          "step": ""
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"e.g. Introduction to Integral Calculus\"]",
          "text": "Níveis de organização dos seres vivos",
          "delay": 35
        },
        {
          "do": "wait",
          "ms": 600
        }
      ]
    },
    {
      "id": "criar-desc",
      "say": "A série nasce vazia, e você acrescenta cada lição à mão.",
      "actions": [
        {
          "do": "highlight",
          "selector": "textarea[placeholder^=\"Briefly describe\"]",
          "ms": 3000
        },
        {
          "do": "wait",
          "ms": 500
        }
      ]
    },
    {
      "id": "criar-fim",
      "say": "Use essa forma quando já tem o plano pronto.",
      "actions": [
        {
          "do": "wait",
          "ms": 800
        },
        {
          "do": "press",
          "key": "Escape"
        },
        {
          "do": "wait",
          "ms": 1200
        }
      ]
    },
    {
      "id": "gerar-ia",
      "say": "Para não começar do zero, use Gerar com IA: a IA cria as lições com a progressão e a avaliação, e você revisa depois.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Gerar com IA\")"
        },
        {
          "do": "wait",
          "ms": 900
        },
        {
          "do": "caption",
          "text": "Gerar com IA",
          "step": ""
        },
        {
          "do": "wait",
          "ms": 2200
        }
      ]
    },
    {
      "id": "tema-a",
      "say": "O formulário pede o tema e a disciplina.",
      "actions": [
        {
          "do": "wait",
          "ms": 300
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"e.g. The Industrial Revolution\"]",
          "text": "Níveis de organização dos seres vivos",
          "delay": 35
        },
        {
          "do": "wait",
          "ms": 500
        }
      ]
    },
    {
      "id": "tema-b",
      "say": "Quanto mais contexto der, mais ajustada fica a série.",
      "actions": [
        {
          "do": "type",
          "selector": "input[placeholder=\"e.g. History\"]",
          "text": "Ciências da Natureza",
          "delay": 35
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"e.g. 9th Grade\"]",
          "text": "7.º ano",
          "delay": 35
        },
        {
          "do": "wait",
          "ms": 800
        }
      ]
    },
    {
      "id": "estrutura",
      "say": "Escolha o número de lições. Assim a série já sai com o tamanho que cabe no seu trimestre.",
      "actions": [
        {
          "do": "click",
          "selector": "input[placeholder=\"e.g. 4\"]"
        },
        {
          "do": "press",
          "key": "Control+a"
        },
        {
          "do": "press",
          "key": "Backspace"
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"e.g. 4\"]",
          "text": "6",
          "delay": 60
        },
        {
          "do": "wait",
          "ms": 1500
        }
      ]
    },
    {
      "id": "objetivos",
      "say": "Os objetivos dizem o que o estudante deve conseguir ao final.",
      "actions": [
        {
          "do": "type",
          "selector": "textarea[placeholder^=\"e.g. Learners\"]",
          "text": "Explicar os níveis de organização, da célula ao organismo.",
          "delay": 25
        },
        {
          "do": "wait",
          "ms": 800
        }
      ]
    },
    {
      "id": "gerar-a",
      "say": "Clique em Generate Series.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Generate Series\")"
        },
        {
          "do": "wait",
          "ms": 800
        }
      ]
    },
    {
      "id": "gerar-b",
      "say": "A IA leva alguns minutos e, quando termina, a série aparece na sua biblioteca, com as lições para revisar.",
      "actions": [
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    }
  ]
}