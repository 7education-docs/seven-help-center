{
  "lesson": "serie",
  "baseUrl": "https://sevenai.es",
  "locale": "pt-BR",
  "setup": [
    {
      "do": "goto",
      "url": "/educa/library"
    },
    {
      "do": "waitFor",
      "selector": "text=Série de lições"
    },
    {
      "do": "click",
      "selector": "text=Série de lições"
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Gerar com IA\")"
    }
  ],
  "scenes": [
    {
      "id": "inicio",
      "say": "Uma série de lições planeja um tema completo: as sessões, a progressão e a avaliação. Para não começar do zero, use Gerar com IA.",
      "actions": [
        {
          "do": "caption",
          "text": "Gerar com IA",
          "step": ""
        },
        {
          "do": "highlight",
          "selector": "button:has-text(\"Gerar com IA\")",
          "ms": 2200
        },
        {
          "do": "wait",
          "ms": 6000
        }
      ]
    },
    {
      "id": "tema",
      "say": "O formulário pede o tema, a disciplina e o nível. Quanto mais contexto der, mais ajustada fica a série.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Gerar com IA\")"
        },
        {
          "do": "wait",
          "ms": 1500
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"e.g. The Industrial Revolution\"]",
          "text": "Níveis de organização dos seres vivos",
          "delay": 35
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"e.g. History\"]",
          "text": "Ciências da Natureza",
          "delay": 35
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"e.g. 9th Grade\"]",
          "text": "7.º ano",
          "delay": 35
        },
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    },
    {
      "id": "estrutura",
      "say": "Escolha o número de lições. Assim a série já sai com o tamanho que cabe no seu trimestre.",
      "actions": [
        {
          "do": "click",
          "selector": "input[placeholder=\"e.g. 4\"]"
        },
        {
          "do": "press",
          "key": "Control+a"
        },
        {
          "do": "press",
          "key": "Backspace"
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"e.g. 4\"]",
          "text": "6",
          "delay": 60
        },
        {
          "do": "wait",
          "ms": 5000
        }
      ]
    },
    {
      "id": "objetivos",
      "say": "Os objetivos dizem o que o estudante deve conseguir ao final. A IA organiza as sessões para chegar até eles.",
      "actions": [
        {
          "do": "type",
          "selector": "textarea[placeholder^=\"e.g. Learners\"]",
          "text": "Explicar os níveis de organização, da célula ao organismo.",
          "delay": 25
        },
        {
          "do": "wait",
          "ms": 5000
        }
      ]
    },
    {
      "id": "gerar",
      "say": "Clique em Generate Series. A IA leva alguns minutos e, quando termina, a série aparece na sua biblioteca, com as lições para revisar.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Generate Series\")"
        },
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    }
  ]
}