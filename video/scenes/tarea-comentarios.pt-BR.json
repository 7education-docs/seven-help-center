{
  "lesson": "tarea-comentarios",
  "baseUrl": "https://sevenai.es",
  "locale": "pt-BR",
  "setup": [
    {
      "do": "goto",
      "url": "/educa/courses"
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Criar curso\")"
    },
    {
      "do": "click",
      "selector": "h3:has-text(\"Matemática · 8.º ano\")"
    },
    {
      "do": "waitFor",
      "selector": "button:has-text(\"Adicionar atividade ou material\")"
    }
  ],
  "scenes": [
    {
      "id": "tipo",
      "say": "Tarefa com feedback é um trabalho que você corrige e ao qual devolve comentários, não só uma nota. Pode usar uma tarefa que já criou na biblioteca.",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text(\"Adicionar atividade ou material\")"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "click",
          "selector": "button:has-text(\"Tarefa com feedback\"):not(:has-text(\"Adicionar\"))"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "biblioteca",
      "say": "A biblioteca mostra as tarefas que você já tem. Escolha uma e o curso recebe uma cópia: as mudanças feitas depois na biblioteca não alteram o curso.",
      "actions": [
        {
          "do": "highlight",
          "selector": "button:has-text(\"Tarefa com feedback\") >> nth=0",
          "ms": 2600
        },
        {
          "do": "wait",
          "ms": 8000
        }
      ]
    },
    {
      "id": "fim",
      "say": "Para ver como corrigir e devolver comentários, consulte o artigo de tarefas de correção.",
      "actions": [
        {
          "do": "click",
          "selector": "button:text-is(\"Voltar\")"
        },
        {
          "do": "wait",
          "ms": 4000
        }
      ]
    }
  ]
}