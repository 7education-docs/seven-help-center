{
  "lesson": "tareas-feedback",
  "baseUrl": "https://sevenai.es",
  "locale": "es",
  "setup": [
    {
      "do": "goto",
      "url": "/educa/library/feedback-tasks"
    },
    {
      "do": "waitFor",
      "selector": "button:text-is(\"Crear\")"
    }
  ],
  "scenes": [
    {
      "id": "inicio",
      "say": "Las tareas de corrección y feedback permiten que el asistente revise los trabajos de tus alumnos con los criterios que tú defines.",
      "actions": [
        {
          "do": "highlight",
          "selector": "text=Editados recientemente",
          "ms": 1500
        },
        {
          "do": "wait",
          "ms": 2500
        }
      ]
    },
    {
      "id": "crear",
      "say": "Pulsa Crear para abrir la tarea. Empiezas por el título y la descripción, que el alumnado verá al entregar.",
      "actions": [
        {
          "do": "click",
          "selector": "button:text-is(\"Crear\")"
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "type",
          "selector": "input[placeholder=\"Título de la tarea\"]",
          "text": "Redacción: niveles de organización",
          "delay": 45
        },
        {
          "do": "click",
          "selector": "[placeholder^=\"Descripción de la tarea\"]"
        },
        {
          "do": "type",
          "selector": "[placeholder^=\"Descripción de la tarea\"]",
          "text": "Escribe un texto explicando los niveles de organización de los seres vivos.",
          "delay": 30
        },
        {
          "do": "wait",
          "ms": 1200
        }
      ]
    },
    {
      "id": "rigor",
      "say": "Rigor de la calificación define si la corrección es indulgente, equilibrada o estricta. Elige la que encaje con tu criterio.",
      "actions": [
        {
          "do": "select",
          "selector": "select:has(option:text-is(\"Estricto\"))",
          "value": "Estricto"
        },
        {
          "do": "wait",
          "ms": 1500
        },
        {
          "do": "select",
          "selector": "select:has(option:text-is(\"Estricto\"))",
          "value": "Equilibrado"
        },
        {
          "do": "wait",
          "ms": 1500
        }
      ]
    },
    {
      "id": "criterios",
      "say": "Con Añadir criterio creas cada criterio con su descripción y sus puntos, de 0,5 a 1000.",
      "actions": [
        {
          "do": "highlight",
          "selector": "text=Criterios de calificación",
          "ms": 1500
        },
        {
          "do": "clickAt",
          "x": 1048,
          "y": 580
        },
        {
          "do": "wait",
          "ms": 3000
        }
      ]
    },
    {
      "id": "cerrar",
      "say": "Puedes guardar la tarea, compartirla con tus alumnos o editarla más adelante desde la lista.",
      "actions": [
        {
          "do": "press",
          "key": "Escape"
        },
        {
          "do": "wait",
          "ms": 1200
        }
      ]
    }
  ]
}
